<Window x:Class="SFM.AddDialogueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SFM"
        mc:Ignorable="d"
        Title="AddDialogueWindow" Height="auto" Width="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Name 0_1-->
            
            <!--Avatar 8_10-->
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <!--Avatar-->
        <TextBlock 
             Text="Диалоги Имя Npc"
             FontSize="16"
             Grid.Row="2"/> 
        <TextBox x:Name="DialogueNameBox"
             Grid.Row="3"
             Margin="0,10,0,0"/>
        <TextBlock 
            Text="Выбери Npc"
            FontSize="16"
            Grid.Row="0"/>
        <ComboBox x:Name="ChooseNpcBox"
             Grid.Row="1"
             Margin="0,10,0,0"
             DisplayMemberPath="Name"
             />    
        <StackPanel
            
            Grid.Row="4"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,20,0,0">
            <DockPanel DockPanel.Dock="Bottom">
                <Button
                    Content="Создать"
                    Width="90"
                    Margin="0,0,10,0"
                    Click="CreateDia_Click"/>

                <Button
                    Content="Отмена"
                    Width="80"
                    Click="Cancel_Click"/>
            </DockPanel>
        
        </StackPanel>
    </Grid>
</Window>
