<Window x:Class="SFM.AddNpcWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SFM"
        mc:Ignorable="d"
        Title="Создание NPC" Height="auto" Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Name 0_1-->
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <!--Description 2_3-->

            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <!--Backstory 4_5-->
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <!--Style 6_7-->
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <!--Avatar 8_10-->
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <!-- Name-->
        <TextBlock 
            Text="Имя Npc"
            FontSize="16"/>
        <TextBox x:Name="NameBox"
                 Grid.Row="1"
                 Margin="0,10,0,0"/>
       
 
        <!--Description-->
        <TextBlock 
            Text="Описание Npc"
            FontSize="16"
            Grid.Row="2"/>
        <TextBox x:Name="DescriptionBox"
             Grid.Row="3"
             Margin="0,10,0,0"/>

        <!--Backstory-->
        <TextBlock 
            Text="Предыстория Npc"
            FontSize="16"
            Grid.Row="4"/>
        <TextBox x:Name="BackstoryBox"
             Grid.Row="5"
             Margin="0,10,0,0"/>
        <!--Style-->
        <TextBlock 
            Text="Стиль речи или особенность Npc"
            FontSize="16"
            Grid.Row="6"/>
        <TextBox x:Name="StyleDialogueBox"
            Grid.Row="7"
            Margin="0,10,0,0"/>

        <!--Avatar-->
        <TextBlock 
            Text="Аватар Npc"
            FontSize="16"
            Grid.Row="8"/>
        <TextBox x:Name="AvatarBox"
            Grid.Row="9"
            Margin="0,10,0,0"/>
        <StackPanel
            Grid.Row="10"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,20,0,0">

        <Button
            Content="Создать"
            Width="90"
            Margin="0,0,10,0"
            Click="Create_Click"/>

        <Button
            Content="Отмена"
            Width="80"
            Click="Cancel_Click"/>  
        </StackPanel>
    </Grid>
</Window>
