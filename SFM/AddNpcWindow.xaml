<Window x:Class="SFM.AddNpcWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SFM"
        mc:Ignorable="d"
        Title="Создание NPC" Height="auto" Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <!-- Конвертеры (оставляем как было) -->
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToHiddenConverter"/>
        <local:EqualityConverter x:Key="EqualityConverter"/>

        <!-- ЦВЕТОВАЯ ПАЛИТРА QUESTSMITH -->
        <SolidColorBrush x:Key="BgDark" Color="#2B2B2B"/>
        <!-- Фон окна -->
        <SolidColorBrush x:Key="PanelDark" Color="#1A1A1E"/>
        <!-- Фон панелей -->
        <SolidColorBrush x:Key="AccentPurple" Color="#BB86FC"/>
        <!-- Фиолетовый акцент -->
        <SolidColorBrush x:Key="AccentTeal" Color="#03DAC6"/>
        <!-- Бирюзовый акцент (для +) -->
        <SolidColorBrush x:Key="TextMain" Color="#E0E0E0"/>
        <!-- Основной текст -->
        <SolidColorBrush x:Key="BorderDark" Color="#333338"/>
        <!-- Границы -->

        <!-- ОБНОВЛЕННЫЙ СТИЛЬ ВЕРХНИХ КНОПОК -->
        <Style x:Key="TopButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" 
                    BorderBrush="{StaticResource BorderDark}" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Background="{StaticResource PanelDark}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Эффект при наведении -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#252529"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                            </Trigger>
                            <!-- Эффект при нажатии -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource AccentPurple}"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ОБНОВЛЕННЫЙ СТИЛЬ КНОПОК "+" -->
        <Style x:Key="PlusButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentPurple}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" CornerRadius="16" Background="{TemplateBinding Background}">
                            <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource BgDark}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Name 0_1-->
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <!--Description 2_3-->

            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <!--Backstory 4_5-->
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <!--Style 6_7-->
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <!--Avatar 8_10-->
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <!-- Name-->
        <TextBlock 
            Text="Имя Npc"
            FontSize="16"
            Foreground="{StaticResource AccentPurple}"/>
        <TextBox x:Name="NameBox"
                 Grid.Row="1"
                 Margin="0,10,0,0"
                 Background="{StaticResource BorderDark}" Foreground="{StaticResource TextMain}"/>
       
 
        <!--Description-->
        <TextBlock 
            Text="Описание Npc"
            FontSize="16"
            Grid.Row="2"
            Foreground="{StaticResource AccentPurple}"/>
        <TextBox x:Name="DescriptionBox"
             Grid.Row="3"
             Margin="0,10,0,0"
                 Background="{StaticResource BorderDark}" Foreground="{StaticResource TextMain}"/>

        <!--Backstory-->
        <TextBlock 
            Text="Предыстория Npc"
            FontSize="16"
            Grid.Row="4"
            Foreground="{StaticResource AccentPurple}"/>
        <TextBox x:Name="BackstoryBox"
             Grid.Row="5"
             Margin="0,10,0,0"
                 Background="{StaticResource BorderDark}" Foreground="{StaticResource TextMain}"/>
        <!--Style-->
        <TextBlock 
            Text="Стиль речи или особенность Npc"
            FontSize="16"
            Grid.Row="6"
            Foreground="{StaticResource AccentPurple}"/>
        <TextBox x:Name="StyleDialogueBox"
            Grid.Row="7"
            Margin="0,10,0,0"
                 Background="{StaticResource BorderDark}" Foreground="{StaticResource TextMain}"/>

        <!--Avatar-->
        <TextBlock 
            Text="Аватар Npc"
            FontSize="16"
            Grid.Row="8"
            Foreground="{StaticResource AccentPurple}"/>
        <TextBox x:Name="AvatarBox"
            Grid.Row="9"
            Margin="0,10,0,0"
                 Background="{StaticResource BorderDark}" Foreground="{StaticResource TextMain}"/>
        <StackPanel
            Grid.Row="10"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,20,0,0">

        <Button
            Content="Создать"
            Style="{StaticResource TopButtonStyle}"
            Click="Create_Click"/>

        <Button
            Content="Отмена"
                        Style="{StaticResource TopButtonStyle}"

            Click="Cancel_Click"/>  
        </StackPanel>
    </Grid>
    </Border>
</Window>
