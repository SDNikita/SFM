<Window x:Class="SFM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SFM.ViewModels"
        xmlns:local="clr-namespace:SFM" d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="Dialogue Editor" Height="768" Width="1024">

    <Window.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToHiddenConverter"/>
        <local:EqualityConverter x:Key="EqualityConverter"/>


        <!-- Стиль для кнопок в верхней панели -->
        <Style x:Key="TopButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border BorderBrush="Black" BorderThickness="1" CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для маленьких кнопок "+" -->
        <Style x:Key="PlusButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border BorderBrush="Black" BorderThickness="1" CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>




    <Border BorderBrush="Black" BorderThickness="1" CornerRadius="20" Margin="10" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Верхняя панель -->
                <RowDefinition Height="150"/>
                <!-- Основная область -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель с кнопками -->
            <Grid Grid.Row="0">
                <Border BorderBrush="Black" BorderThickness="0,0,0,1"/>

                <!-- Новая кнопка СЛЕВА -->
                <Button Content="Открыть проект" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Center" 
            Margin="20,0,0,0"
            Padding="15,5"
            Command="{Binding OpenProjectCommand}"
            Style="{StaticResource TopButtonStyle}"/>
                <!-- Используем твой стиль -->

                <!-- Твои кнопки справа (Конструктор, Симулятор...) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Button Content="Конструктор" Style="{StaticResource TopButtonStyle}"/>
                    <Button Content="Симулятор" Style="{StaticResource TopButtonStyle}"/>
                    <Button Content="Импорт" Style="{StaticResource TopButtonStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Основная рабочая областьь-->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- НПС-->
                    <Border BorderBrush="Black" BorderThickness="0,0,1,1" Padding="15">
                        <DockPanel LastChildFill="False">
                            <Button Content="+" Style="{StaticResource PlusButtonStyle}" DockPanel.Dock="Right" VerticalAlignment="Top" Click="AddNpcButton_Click"/>
                            <TextBlock Text="NPC" FontSize="20" DockPanel.Dock="Top" VerticalAlignment="Top"/>
                            <ListBox x:Name="NpcList" Margin="10,0,0,0" Width="165" 
                                     Background="#FFC4C4C4" SelectionChanged="NpcList_SelectionChanged"
                                     ItemsSource="{Binding Npcs}" 
                                     SelectedItem="{Binding SelectedNpc, Mode=TwoWay}"
                                     DisplayMemberPath="Name"/> 
                            
    
                        </DockPanel>

                    </Border>
                    <!-- Диалоги-->
                    <Border Grid.Row="1" BorderBrush="Black" BorderThickness="0,0,1,0" Padding="15">
                        <DockPanel LastChildFill="False">
                            <Button Content="+" Style="{StaticResource PlusButtonStyle}" DockPanel.Dock="Right" VerticalAlignment="Top" Click="AddDialogueButton_Click"/>
                            <TextBlock Text="Диалоги" FontSize="20" DockPanel.Dock="Top" Height="49"/>
                            <ListBox x:Name="DialogueList" Margin="10,0,0,0" Background="#FFC4C4C4" Width="165"/>

                        </DockPanel>
                    </Border>
                </Grid>

                <Border Grid.Column="1" Background="#1E1E1E" ClipToBounds="True">
                    <Grid Background="#1E1E1E">
                        <!-- Фон теперь здесь -->

                        <!-- Слой линий (снизу) -->
                        <Canvas x:Name="ConnectionsCanvas" Panel.ZIndex="0" IsHitTestVisible="False" Background="Transparent"/>

                        <!-- Кнопка (сверху всех) -->
                        <Button Content="+ Создать реплику (Node)" 
                            HorizontalAlignment="Left" VerticalAlignment="Top" 
                            Margin="15" Padding="10,5" Panel.ZIndex="10"
                            Background="#3D3D3D" Foreground="#660BAB"
                            Click="AddNode_Click"/>

                        <!-- Слой узлов -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" 
                             Panel.ZIndex="1" Background="Transparent">
                            <ItemsControl ItemsSource="{Binding CurrentNodes}">
                                <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Background="Transparent" Width="2000" Height="2000" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Добавляем PreviewMouseDown для выбора ноды -->
                                        <Thumb DragDelta="Node_DragDelta" PreviewMouseDown="Node_PreviewMouseDown">
                                            <Thumb.Template>
                                                <ControlTemplate>
                                                    <!-- Даем имя бордеру, чтобы триггер мог его найти -->
                                                    <Border x:Name="NodeBorder" 
                                                            Width="180" Background="#2D2D2D" 
                                                            CornerRadius="5" BorderBrush="#555" BorderThickness="1">
                                                        <StackPanel>
                                                            <Border Background="MediumPurple" Padding="5">
                                                                <TextBlock Text="NPC REPLY" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Text}" Margin="10" Foreground="White" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <ControlTemplate.Triggers>
                                                        <!-- Триггер: если этот Node является выбранным во ViewModel -->
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                    <Binding />
                                                                    <!-- Текущий Node -->
                                                                    <Binding Path="DataContext.SelectedNode" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>

                                                            <!-- Эффект подсветки -->
                                                            <Setter TargetName="NodeBorder" Property="BorderBrush" Value="Cyan"/>
                                                            <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2"/>
                                                            <Setter TargetName="NodeBorder" Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect BlurRadius="15" Color="Cyan" ShadowDepth="0" Opacity="0.8"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>


                <!-- свойства-->
                <Border Grid.Column="2" BorderBrush="#DDD" BorderThickness="1,0,0,0" Background="White">
                    <Grid Margin="15" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                    <TextBlock Text="Свойства" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" FontWeight="Bold"/>
                        <!-- свойства для нпс-->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedNpc, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel DataContext="{Binding SelectedNpc}">

                                <TextBlock Text="Имя:" Margin="0,5,0,2" Foreground="Gray" FontSize="14"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger= PropertyChanged}" 
                                         FontSize="14" Padding="5" Margin="0,0,0,10"/>
                                
                                <TextBlock Text="Описание: " Margin="0,5,0,2" Foreground="Gray" FontSize="14"/>
                                <TextBox Text="{Binding Description, UpdateSourceTrigger= PropertyChanged}" 
                                         FontSize="14" Padding="5" Margin="0,0,0,10" 
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>

                                <TextBlock Text="Предыстория:" Margin="0,5,0,2" Foreground="Gray"/>
                                <TextBox Text="{Binding Backstory, UpdateSourceTrigger=PropertyChanged}" 
                                    AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                                    Padding="5" Margin="0,0,0,10"/>

                                <TextBlock Text="Стиль диалога:" Margin="0,5,0,2" Foreground="Gray"/>
                                <TextBox Text="{Binding DialogueStyle, UpdateSourceTrigger=PropertyChanged}" 
                                    Padding="5" Margin="0,0,0,10"/>

                                <TextBlock Text="URL Аватара:" Margin="0,5,0,2" Foreground="Gray"/>
                                <TextBox Text="{Binding AvatarUrl, UpdateSourceTrigger=PropertyChanged}" 
                                    Padding="5" Margin="0,0,0,10"/>
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock Grid.Row="1" Text="Выберите NPC из списка слева" 
                   VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray" TextWrapping="Wrap" TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <!-- По умолчанию скрыта -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNpc}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <!-- Показать, если NULL -->
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Grid.Row="2" Content="Сохранить изменения" 
                            Command="{Binding SaveCommand}"
                            Height="40" Margin="0,10,0,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>
                
            </Grid>
        </Grid>
    </Border>

</Window>