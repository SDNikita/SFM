<Window x:Class="SFM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SFM.ViewModels"
        xmlns:local="clr-namespace:SFM" d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="Dialogue Editor" Height="768" Width="1024"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Конвертеры (оставляем как было) -->
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToHiddenConverter"/>
        <local:EqualityConverter x:Key="EqualityConverter"/>

        <!-- ЦВЕТОВАЯ ПАЛИТРА QUESTSMITH -->
        <SolidColorBrush x:Key="BgDark" Color="#2B2B2B"/>
        <!-- Фон окна -->
        <SolidColorBrush x:Key="PanelDark" Color="#1A1A1E"/>
        <!-- Фон панелей -->
        <SolidColorBrush x:Key="AccentPurple" Color="#BB86FC"/>
        <!-- Фиолетовый акцент -->
        <SolidColorBrush x:Key="AccentTeal" Color="#03DAC6"/>
        <!-- Бирюзовый акцент (для +) -->
        <SolidColorBrush x:Key="TextMain" Color="#E0E0E0"/>
        <!-- Основной текст -->
        <SolidColorBrush x:Key="BorderDark" Color="#333338"/>
        <!-- Границы -->

        <!-- ОБНОВЛЕННЫЙ СТИЛЬ ВЕРХНИХ КНОПОК -->
        <Style x:Key="TopButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" 
                            BorderBrush="{StaticResource BorderDark}" 
                            BorderThickness="1" 
                            CornerRadius="12" 
                            Background="{StaticResource PanelDark}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Эффект при наведении -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#252529"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                            </Trigger>
                            <!-- Эффект при нажатии -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource AccentPurple}"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ОБНОВЛЕННЫЙ СТИЛЬ КНОПОК "+" -->
        <Style x:Key="PlusButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentPurple}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" CornerRadius="16" Background="{TemplateBinding Background}">
                            <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>




    <Border Background="{StaticResource BgDark}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Верхняя панель -->
                <RowDefinition Height="150"/>
                <!-- Основная область -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель с кнопками -->
            <Grid Grid.Row="0">
                <Border BorderBrush="Black" BorderThickness="0,0,0,1"/>

                <!-- Новая кнопка СЛЕВА -->
                <Button Content="Открыть проект" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Center" 
            Margin="20,0,0,0"
            Padding="15,5"
            Command="{Binding OpenProjectCommand}"
            Style="{StaticResource TopButtonStyle}"/>
                <!-- Используем твой стиль -->

                <!-- Твои кнопки справа (Конструктор, Симулятор...) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Button Content="Конструктор" Style="{StaticResource TopButtonStyle}"/>
                    <Button Content="Симулятор" Style="{StaticResource TopButtonStyle}"/>
                    <Button Content="Импорт" Style="{StaticResource TopButtonStyle}" />
                </StackPanel>
            </Grid>

            <!-- Основная рабочая областьь-->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- НПС-->
                    <Border BorderBrush="Black" BorderThickness="0,0,1,1" Padding="15">
                        <DockPanel LastChildFill="False">
                            <Button Content="+" Style="{StaticResource PlusButtonStyle}" DockPanel.Dock="Right" VerticalAlignment="Top" Click="AddNpcButton_Click"/>
                            <TextBlock Text="NPC" FontSize="20" DockPanel.Dock="Top" VerticalAlignment="Top" Foreground="{StaticResource TextMain}"/>
                            <ListBox x:Name="NpcList" Margin="10,0,0,0" Width="165" 
                                     Background="{StaticResource PanelDark}" SelectionChanged="NpcList_SelectionChanged"
                                     ItemsSource="{Binding Npcs}" 
                                     SelectedItem="{Binding SelectedNpc, Mode=TwoWay}"
                                     DisplayMemberPath="Name"
                                     Foreground="Gray"/> 
                            
    
                        </DockPanel>

                    </Border>
                    <!-- Диалоги-->
                    <Border Grid.Row="1" BorderBrush="Black" BorderThickness="0,0,1,0" Padding="15">
                        <DockPanel LastChildFill="False">
                            <Button Content="+" Style="{StaticResource PlusButtonStyle}" DockPanel.Dock="Right" VerticalAlignment="Top" Click="AddDialogueButton_Click"/>
                            <TextBlock Text="Диалоги" Foreground="{StaticResource TextMain}" FontSize="20" DockPanel.Dock="Top" Height="49"/>
                            <ListBox x:Name="DialogueList" Margin="10,0,0,0" Background="{StaticResource PanelDark}" Width="165" Foreground="Gray"/>

                        </DockPanel>
                    </Border>
                </Grid>

                <Border Grid.Column="1" Background="#1E1E1E" ClipToBounds="True"
                    MouseWheel="Editor_MouseWheel" 
                    MouseDown="Editor_MouseDown" 
                    MouseMove="Editor_MouseMove" 
                    MouseUp="Editor_MouseUp">
                    <Grid>
                        <!-- Этот Canvas — наш "бесконечный" холст -->
                        <Canvas x:Name="EditorContent"  Width="5000" Height="5000">
                            <!-- Рисуем сетку (точки) -->
                            <Canvas.Background>
                                <VisualBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
                                    <VisualBrush.Visual>
                                        <Ellipse Fill="#252525" Width="2" Height="2"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Canvas.Background>

                            <!-- СЛОЙ 1: ЛИНИИ (под узлами) -->
                            <Canvas x:Name="ConnectionsCanvas" Background="Transparent" IsHitTestVisible="True" Panel.ZIndex="0"/>

                            <!-- СЛОЙ 2: УЗЛЫ (над линиями) -->
                            <ItemsControl ItemsSource="{Binding CurrentNodes}" Panel.ZIndex="1">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Background="Transparent" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Thumb DragDelta="Node_DragDelta" PreviewMouseDown="Node_PreviewMouseDown">
                                            <Thumb.Template>
                                                <ControlTemplate>
                                                    <Border x:Name="NodeBorder" Width="180" Background="#2D2D2D" 
                                            CornerRadius="5" BorderBrush="#555" BorderThickness="1">
                                                        <StackPanel>
                                                            <Border Background="MediumPurple" Padding="5">
                                                                <TextBlock Text="NPC REPLY" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Text}" Margin="10" Foreground="White" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                    <Binding />
                                                                    <Binding Path="DataContext.SelectedNode" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter TargetName="NodeBorder" Property="BorderBrush" Value="MediumPurple"/>
                                                            <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2"/>
                                                            <Setter TargetName="NodeBorder" Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect BlurRadius="15" Color="MediumPurple" ShadowDepth="0" Opacity="0.8"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Трансформация для зума и панорамы -->
                            <Canvas.RenderTransform>
                                <MatrixTransform x:Name="EditorMatrixTransform"/>
                            </Canvas.RenderTransform>
                        </Canvas>

                        <!-- Кнопка (не зумится, всегда в углу) -->
                        <Button Content="+ Создать реплику" 
                HorizontalAlignment="Left" VerticalAlignment="Top" 
                Margin="15" Padding="10,5" Panel.ZIndex="10"
                Background="#3D3D3D" Foreground="MediumPurple"
                Click="AddNode_Click"/>
                    </Grid>
                </Border>


                <!-- свойства-->
                <Border Grid.Column="2" Background="{StaticResource BgDark}">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Свойства" Foreground="MediumPurple" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

                        <!-- КОНТЕЙНЕР ДЛЯ ВСЕХ СВОЙСТВ -->
                        <Grid Grid.Row="1">

                            <!-- 1. СВОЙСТВА НОДЫ (Высший приоритет) -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <!-- Показываем, если SelectedNode НЕ равен null -->
                                            <DataTrigger Binding="{Binding SelectedNode, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>

                                <StackPanel DataContext="{Binding SelectedNode}">
                                    <Button Content="Удалить эту реплику" 
                                            Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Background="#FF4C4C" Foreground="White" FontWeight="Bold" 
                                            Margin="0,0,0,15" Height="25">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <TextBlock Text="Текст реплики (Node):" Foreground="Gray" FontWeight="Bold"/>
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" 
                                        AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" Margin="0,5" Padding="5"
                                             Background="{StaticResource PanelDark}" Foreground="{StaticResource TextMain}"/>
                                    <!-- Внутри StackPanel свойств ноды -->
                                    <Border BorderBrush="{StaticResource PanelDark}" BorderThickness="0,1,0,0" Margin="0,15,0,0" Padding="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Создать переход Выбор игрока:" Foreground="MediumPurple" FontWeight="Bold" Margin="0,0,0,10"/>

                                            <TextBlock Text="Куда ведет выбор:" Foreground="Gray" FontSize="10" FontWeight="Bold"/>
                                            <!-- Выпадающий список всех нод этого диалога -->
                                            <ComboBox ItemsSource="{Binding DataContext.CurrentNodes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DataContext.TargetNodeForConnection, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Margin="0,5,0,10" Padding="5"
                                                      Background="{StaticResource PanelDark}" >
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Text, TargetNullValue='(Пустая реплика)'}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <TextBlock Text="Текст выбора (Ответ игрока):" Foreground="Gray" FontSize="10" FontWeight="Bold"/>
                                            <TextBox Text="{Binding DataContext.NewConnectionText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" 
                                                 Margin="0,5,0,10" Padding="5"
                                                    Background="{StaticResource PanelDark}" Foreground="{StaticResource TextMain}" />

                                            <Button Content="Создать связь" 
                                                Command="{Binding DataContext.AddConnectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Background="MediumPurple" Foreground="White" FontWeight="Bold" Height="30">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="5"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 2. СВОЙСТВА NPC (Показываем, только если нода НЕ выбрана, а NPC выбран) -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <!-- NPC показываем только если: -->
                                                    <Condition Binding="{Binding SelectedConnection}" Value="{x:Null}"/>
                                                    <!-- 1. СВЯЗЬ НЕ ВЫБРАНА (Добавь это!) -->
                                                    <Condition Binding="{Binding SelectedNode}" Value="{x:Null}"/>
                                                    <!-- 2. НОДА НЕ ВЫБРАНА -->
                                                    <Condition Binding="{Binding SelectedNpc, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible"/>
                                                    <!-- 3. NPC ВЫБРАН -->
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>

                                <!-- Свойста нпс -->
                                <StackPanel DataContext="{Binding SelectedNpc}">
                                    <TextBlock Text="Имя NPC:" Foreground="Gray"/>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource PanelDark}" Foreground="{StaticResource TextMain}" Margin="0,5" Padding="5"/>
                                    <TextBlock Text="Описание:" Foreground="Gray" Margin="0,10,0,0"/>
                                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                                        AcceptsReturn="True" MinHeight="60" Padding="5"
                                             Background="{StaticResource PanelDark}" Foreground="{StaticResource TextMain}"/>
                                    <TextBlock Text="Предыстория:" Foreground="Gray" Margin="0,10,0,0"/>
                                    <TextBox Text="{Binding Backstory, UpdateSourceTrigger=PropertyChanged}" 
                                        AcceptsReturn="True" MinHeight="60" Padding="5"
                                             Background="{StaticResource PanelDark}" Foreground="{StaticResource TextMain}"/>
                                    <TextBlock Text="Стиль речи:" Foreground="Gray" Margin="0,10,0,0"/>
                                    <TextBox Text="{Binding DialogueStyle, UpdateSourceTrigger=PropertyChanged}" 
                                        AcceptsReturn="True" MinHeight="60" Padding="5"
                                             Background="{StaticResource PanelDark}" Foreground="{StaticResource TextMain}"/>
                                </StackPanel>
                            </ScrollViewer>
                            <!-- 3. СВОЙСТВА ВЫБРАННОЙ СВЯЗИ -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedConnection, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>

                                <StackPanel DataContext="{Binding SelectedConnection}">
                                    <TextBlock Text="Вариант ответа игрока:" Foreground="MediumPurple" FontWeight="Bold"/>
                                    <TextBox Text="{Binding ChoiceText, UpdateSourceTrigger=PropertyChanged}" 
                                        Margin="0,10" Padding="5" AcceptsReturn="True" TextWrapping="Wrap"/>

                                    <Button Content="Удалить этот переход" 
                                        Command="{Binding DataContext.RemoveConnectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Background="#FF4C4C" Foreground="White" Margin="0,20,0,0"/>     
                                </StackPanel>
                            </ScrollViewer>
                            <!-- 3. ЗАГЛУШКА (Если совсем ничего не выбрано) -->
                            <TextBlock Text="Выберите объект (NPC, реплику или связь)" 
                               VerticalAlignment="Center" HorizontalAlignment="Center" 
                               Foreground="Gray" TextAlignment="Center" TextWrapping="Wrap">    
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <!-- Теперь проверяем ТРИ условия. Если всё пусто - показываем текст -->
                                                    <Condition Binding="{Binding SelectedNpc}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding SelectedNode}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding SelectedConnection}" Value="{x:Null}"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Grid.Row="2" Content="Сохранить проект"  Style="{StaticResource TopButtonStyle}" FontSize="14" Command="{Binding SaveCommand}" />
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Border>

</Window>